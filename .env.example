# ─── Supabase ────────────────────────────────────────────────────────────────
NUXT_PUBLIC_SUPABASE_URL=your_supabase_url
NUXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# Server-only. Never expose it to the client or paste it anywhere public.
NUXT_SUPABASE_SERVICE_KEY=your_supabase_service_key
# Used by `npm run migrate` (Supabase > Project Settings > Database > Connection string)
DATABASE_URL=your_database_url

# ─── Site ────────────────────────────────────────────────────────────────────
NUXT_PUBLIC_SITE_URL=https://chasthub.com

# ─── Stripe (leave empty until payments launch) ──────────────────────────────
# While NUXT_PUBLIC_STRIPE_PUBLISHABLE_KEY is empty the app runs on the 30-day
# free trial only (migration 001): the upgrade page shows the trial state and
# the Stripe routes answer 503.
NUXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
NUXT_STRIPE_SECRET_KEY=
NUXT_STRIPE_WEBHOOK_SECRET=
NUXT_STRIPE_MONTHLY_PRICE_ID=
NUXT_STRIPE_YEARLY_PRICE_ID=

# ─── Web Push (generate with: npx web-push generate-vapid-keys) ──────────────
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_EMAIL=mailto:founder@chasthub.com

# ─── Feature flags ───────────────────────────────────────────────────────────
# true = open signup, false = login + waitlist gating
NUXT_PUBLIC_SIGNUPS_ENABLED=true

# Require new accounts to confirm their email before they can log in. Leave
# false until BOTH are done in the Supabase project:
#   1. Authentication > Providers > Email > "Confirm email" is ON
#   2. Project Settings > Auth > SMTP Settings points at real SMTP (e.g. Resend)
# The built-in Supabase mailer is capped at a few mails per hour.
NUXT_PUBLIC_REQUIRE_EMAIL_CONFIRMATION=false

# ─── Analytics (optional; empty = off, there is no fallback project) ─────────
NUXT_PUBLIC_CLARITY_PROJECT_ID=
NUXT_PUBLIC_GA_MEASUREMENT_ID=
